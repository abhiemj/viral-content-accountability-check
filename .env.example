# Copy this file to ".env" and fill in your values.

# Required: Google Fact Check Tools API key.
# Get one at https://console.cloud.google.com/ -> enable "Fact Check Tools API" -> create API key.
GOOGLE_FACTCHECK_API_KEY=

# Optional: default language for fact-check queries (ISO code, e.g. en, hi).
DEFAULT_LANGUAGE=en

# Optional: max number of claims to auto-extract from a video transcript.
MAX_CLAIMS=10
